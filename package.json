{
  "name": "selfhosted-mobile",
  "main": "expo-router/entry",
  "version": "0.5.1",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "start:metro-clean": "APP_VARIANT=development expo start -c",
    "android": "APP_VARIANT=development bun run prebuild && expo run:android",
    "android:preview": "APP_VARIANT=preview bun run prebuild && expo run:android --variant release",
    "android:prod": "APP_VARIANT=production bun run prebuild && expo run:android --variant release",
    "ios": "APP_VARIANT=development bun run prebuild && expo run:ios",
    "web": "APP_VARIANT=development expo start --web",
    "lint": "expo lint",
    "android:eas-dev": "eas build --local --profile development --platform android",
    "android:eas-preview": "eas build --local --profile preview --platform android",
    "android:eas-prod": "eas build --local --profile production --platform android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "gen:schema": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "@dev-plugins/react-query": "^0.4.0",
    "@expo/ui": "~57.0.13",
    "@lingui/core": "^5.9.3",
    "@lingui/react": "^5.9.3",
    "@tanstack/query-async-storage-persister": "^5.102.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-persist-client": "^5.95.2",
    "@valibot/to-json-schema": "^1.7.1",
    "expo": "~57.0.16",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "linkedom": "^0.18.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-enriched-markdown": "^0.4.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.2.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tab-view": "^4.3.2",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "stan-js": "^1.9.1",
    "turndown": "^7.2.4",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.9.3",
    "@lingui/cli": "^5.9.3",
    "@lingui/metro-transformer": "^5.9.3",
    "@tanstack/eslint-plugin-query": "^5.95.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.2",
    "@types/turndown": "^5.0.6",
    "babel-plugin-macros": "^3.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lingui": "^0.11.0",
    "eslint-plugin-perfectionist": "^5.7.0",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
